# Environment Mode (development | production | test)
NODE_ENV=development

# Server Port
PORT=8000

# Client Application URLs (supports comma-separated list in production)
CLIENT_URL=http://localhost:5173,https://suryaworks.xyz,https://www.suryaworks.xyz
FRONTEND_URL=http://localhost:5173,https://suryaworks.xyz,https://www.suryaworks.xyz

# Database Connection (Required in production)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>?retryWrites=true&w=majority

# Email Service (Resend)
EMAIL_USER=onboarding@resend.dev
RESEND_API_KEY=re_your_resend_api_key
ADMIN_EMAIL=admin@yourdomain.com

# Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_characters

# Cloudinary Storage
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_KEY=your_cloudinary_api_key
CLOUD_SECRET=your_cloudinary_api_secret
